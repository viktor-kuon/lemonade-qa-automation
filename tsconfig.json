{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["**/*"],
  "exclude": [
    "node_modules",
    "test-results",
    "playwright-report",
    "blob-report",
    "playwright/.cache",
    "playwright/.auth"
  ]
}
